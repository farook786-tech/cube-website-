# Supabase Configuration
# When SUPABASE_SERVICE_ROLE_KEY and the URL are set, the CMS stores all content
# in PostgreSQL (table cms_store) and uploads in Supabase Storage — required for
# Vercel / serverless hosting. Leave them empty to use the local JSON file
# (data-store/) for development. Setup: run supabase/migrations/002_cms_store.sql,
# then `node scripts/migrate-to-supabase.mjs` to copy existing local content.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
# SERVER ONLY — never prefix with NEXT_PUBLIC_. Bypasses RLS.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Optional overrides
# CMS_BACKEND=file            # force local JSON store even if Supabase keys exist
# SUPABASE_UPLOADS_BUCKET=cms-uploads
# SUPABASE_RESUMES_BUCKET=resumes

# JWT & Admin Session Secret
# REQUIRED. Generate a unique value per environment, e.g.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_JWT_SECRET=change-me-generate-a-unique-64-char-secret

# Audit log signing key (tamper evidence for Security & Audit Logs).
# REQUIRED on the server. Generate it like the secret above, keep a copy with
# your backups, and NEVER change it: entries signed with an old key can no
# longer be verified.
AUDIT_LOG_KEY=change-me-generate-a-unique-64-char-secret

# Default Super Admin Seed Credentials (used only when the data store is first created)
DEFAULT_ADMIN_EMAIL=admin@example.com
DEFAULT_ADMIN_PASSWORD=change-me-before-first-run

# Public Site Configuration
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Admin session cookie. The cookie is marked Secure automatically when the site
# is reached over HTTPS (all real deployments). Set to true to force Secure even
# on plain http (this disables sign-in over http://<ip> on your local network).
ADMIN_COOKIE_SECURE=false

# Interim preview setup only (admin on a local PC, read-only site on Vercel):
# publish public content to GitHub after each admin save. Leave unset on the
# production server, where the website and admin run as one app.
# PUBLISH_TO_GITHUB=true
